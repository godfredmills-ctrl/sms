// =============================================================================
// School Management System — data model
// Target: PostgreSQL (Railway). Money is stored in MINOR UNITS (pesewas) as Int
// to keep arithmetic exact; see src/lib/money.ts for formatting helpers.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PortalType {
  STAFF
  STUDENT
  GUARDIAN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum StudentStatus {
  APPLICANT
  OFFERED
  ENROLLED
  ON_LEAVE
  SUSPENDED
  GRADUATED
  TRANSFERRED_OUT
  WITHDRAWN
  ALUMNI
}

enum StaffStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
  RETIRED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  NATIONAL_SERVICE
  INTERN
  VOLUNTEER
}

enum TermType {
  TERM
  SEMESTER
}

