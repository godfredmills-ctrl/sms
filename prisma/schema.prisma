  ABSENT
  LATE
  EXCUSED
  SICK
  HALF_DAY
}

enum AttendanceSessionType {
  DAILY
  MORNING
  AFTERNOON
  PERIOD
  ACTIVITY
  BOARDING
}

enum AssessmentCategory {
  CLASSWORK
  HOMEWORK
  QUIZ
  TEST
  PROJECT
  PRACTICAL
  PRESENTATION
  MIDTERM
  EXAM
  MOCK
  PARTICIPATION
}

enum ReportCardStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  OVERDUE
  CANCELLED
  WRITTEN_OFF
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  REVERSED
}

enum PaymentChannel {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  USSD
  CASH
  CHEQUE
  POS
  WALLET
  SCHOLARSHIP
}

enum PaymentProvider {
  PAYSTACK
  HUBTEL
  FLUTTERWAVE
  MANUAL
  MOCK
}

enum DiscountType {
