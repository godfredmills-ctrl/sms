  FIXED
}

enum MessageChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum DeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  READ
  SKIPPED
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MemoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ISSUED
  ARCHIVED
}

enum ElectionStatus {
  DRAFT
  NOMINATIONS_OPEN
  NOMINATIONS_CLOSED
  SCHEDULED
  OPEN
  CLOSED
  PUBLISHED
  CANCELLED
