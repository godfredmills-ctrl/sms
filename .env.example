# =============================================================================
# School Management System — environment configuration
#
# Copy to `.env` for local development. On Railway, set these as service
# variables instead (Settings -> Variables -> Raw editor).
#
# Values are deliberately unquoted: a dashboard's raw editor keeps quotes as
# part of the value, and a quoted NODE_ENV in particular breaks the Next.js
# build. Do NOT set NODE_ENV yourself — the platform and the build set it.
# =============================================================================

# --- Database (required) ----------------------------------------------------
# Railway: add a PostgreSQL service, then reference it so it stays in sync:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally: the Railway "public" connection string, or a local Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sms?schema=public

# --- App (required) ---------------------------------------------------------
# Public origin, used for links in emails/SMS and for push notifications.
# Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Session lifetime in days
SESSION_TTL_DAYS=7

# Encrypts provider credentials that are set from Settings -> Integrations
# rather than here. Optional: SESSION_SECRET is used when this is blank.
#
# Set it separately only if the two need different rotation schedules —
# rotating SESSION_SECRET signs everyone out, while rotating this one makes
# every stored credential unreadable and they must be pasted in again.
CREDENTIALS_KEY=

# =============================================================================
# Provider credentials
#
# Everything below is OPTIONAL here. All of it can also be set from
# Settings -> Integrations inside the running app, where it is encrypted and
# stored, and where each provider has a Test button that contacts it for real.
#
# Anything set here WINS over anything set in the app, and is shown there
# read-only — so a deployment that wants to pin its own credentials can, and an
# operator reading this file can trust that it is the answer.
#
# Leave a section blank and the school can fill it in themselves without a
# redeploy. That is the point of it being optional.
# =============================================================================

# --- Seed / bootstrap admin -------------------------------------------------
SEED_ADMIN_EMAIL=admin@school.edu.gh
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Claude / Anthropic AI (optional) ---------------------------------------
# Powers report insights, teaching analytics and report-card remarks.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Set to false to hard-disable all AI features regardless of key presence.
AI_ENABLED=true

# --- Payments (optional) ----------------------------------------------------
# Paystack covers Ghana mobile money (MTN/Telecel/AirtelTigo), cards,
# bank transfer and USSD from a single integration.
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=

# --- SMS (optional) ---------------------------------------------------------
SMS_PROVIDER=mock
SMS_SENDER_ID=SCHOOL
ARKESEL_API_KEY=
MNOTIFY_API_KEY=
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=

# --- Email (optional) -------------------------------------------------------
EMAIL_PROVIDER=mock
EMAIL_FROM=School Admin <noreply@school.edu.gh>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Web Push / PWA notifications (optional) --------------------------------
# The one integration with no account behind it — the keys are pure local
# cryptography and cost nothing. Generate them either way:
#
#   npm run setup:integrations      writes a pair into this file
#   Settings -> Integrations        a button, no redeploy
#
# The two keys must come from a single generation. Mixing a public key from one
# with a private key from another looks configured and signs every notification
# with something the browser rejects.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@school.edu.gh

# --- File storage -----------------------------------------------------------
# Storage is the one integration that CANNOT be changed from inside the app.
# Every other setting redirects where new things go; this one would orphan
# everything already stored — a pupil's photograph and a signed consent form
# would still exist and nothing would be able to find them.
#
# "local" writes to a directory on disk. STORAGE_LOCAL_DIR must be an absolute
# path on a mounted volume in production, otherwise uploads live inside the
# container and are lost on every redeploy.
#
# "s3" talks to any S3-compatible store. For Cloudflare R2:
#   STORAGE_DRIVER=s3
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   <- no bucket here
#   S3_BUCKET=sms
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY from an R2 API token
#
# Keep the bucket PRIVATE. Every file is served through /api/files/[id], which
# applies access control per request; a public bucket hands out medical forms
# and fee statements to anyone who guesses a key.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret required by /api/cron/* endpoints (fee reminders, digests).
CRON_SECRET=change-me
