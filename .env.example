# =============================================================================
# School Management System — environment configuration
#
# Copy to `.env` for local development. On Railway, set these as service
# variables instead (Settings -> Variables -> Raw editor).
#
# Values are deliberately unquoted: a dashboard's raw editor keeps quotes as
# part of the value, and a quoted NODE_ENV in particular breaks the Next.js
# build. Do NOT set NODE_ENV yourself — the platform and the build set it.
# =============================================================================

# --- Database (required) ----------------------------------------------------
# Railway: add a PostgreSQL service, then reference it so it stays in sync:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally: the Railway "public" connection string, or a local Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sms?schema=public

# --- App (required) ---------------------------------------------------------
# Public origin, used for links in emails/SMS and for push notifications.
# Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Session lifetime in days
SESSION_TTL_DAYS=7

# --- Seed / bootstrap admin -------------------------------------------------
SEED_ADMIN_EMAIL=admin@school.edu.gh
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Claude / Anthropic AI (optional) ---------------------------------------
# Powers report insights, teaching analytics and report-card remarks.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Set to false to hard-disable all AI features regardless of key presence.
AI_ENABLED=true

# --- Payments (optional) ----------------------------------------------------
# Paystack covers Ghana mobile money (MTN/Telecel/AirtelTigo), cards,
# bank transfer and USSD from a single integration.
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=

# --- SMS (optional) ---------------------------------------------------------
SMS_PROVIDER=mock
SMS_SENDER_ID=SCHOOL
ARKESEL_API_KEY=
MNOTIFY_API_KEY=
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=

# --- Email (optional) -------------------------------------------------------
EMAIL_PROVIDER=mock
EMAIL_FROM=School Admin <noreply@school.edu.gh>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Web Push / PWA notifications (optional) --------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@school.edu.gh

# --- File storage -----------------------------------------------------------
# "local" writes to ./storage. On Railway, attach a volume at /data and set
# STORAGE_LOCAL_DIR=/data/uploads so uploads survive redeploys.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret required by /api/cron/* endpoints (fee reminders, digests).
CRON_SECRET=change-me
